# ============================================================
#  La Ramadita - Configuracion Spring Boot
# ============================================================

# --- Servidor ---
server.port=8080

# --- Base de datos MySQL ---
# Puedes sobreescribir estos valores con variables de entorno:
#   DB_URL, DB_USER, DB_PASSWORD
spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/ramadita_db?useSSL=false&serverTimezone=America/Lima&allowPublicKeyRetrieval=true&useUnicode=true&characterEncoding=UTF-8}
spring.datasource.username=${DB_USER:root}
spring.datasource.password=${DB_PASSWORD:root}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# --- JPA / Hibernate ---
# ddl-auto=update : crea/actualiza tablas automaticamente segun las entidades.
# Cuando el proyecto este estable en produccion, cambiar a "validate".
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.open-in-view=false

# --- Thymeleaf ---
spring.thymeleaf.cache=false

# --- Codificacion ---
server.servlet.encoding.charset=UTF-8
server.servlet.encoding.enabled=true
server.servlet.encoding.force=true

# --- Sesion ---
server.servlet.session.timeout=8h
